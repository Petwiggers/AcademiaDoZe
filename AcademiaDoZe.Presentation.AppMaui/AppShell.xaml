<?xml version="1.0" encoding="UTF-8" ?>
<Shell
     x:Class="AcademiaDoZe.Presentation.AppMaui.AppShell"
     xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
     xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
     xmlns:views="clr-namespace:AcademiaDoZe.Presentation.AppMaui.Views">

    <!--
     <ShellContentTitle="Home" ContentTemplate="{DataTemplate views:MainPage}" Route="MainPage" />
     -->
    <Shell.FlyoutHeader>
        <Grid Padding="12">
            <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                <Image Source="{Binding Source={StaticResource LocalizedStrings}, Path=[strBandeira]}" HeightRequest="28" WidthRequest="42" Aspect="AspectFit"/>
                <!--<Label Text="{Binding Path=[strTitulo], Source={StaticResource LocalizedStrings}}" VerticalOptions="Center" FontAttributes="Bold"/>-->
            </HorizontalStackLayout>
        </Grid>
    </Shell.FlyoutHeader>
    <FlyoutItem Title="{Binding Path=[strDashboard], Source={StaticResource LocalizedStrings}}">
        <FlyoutItem.Icon>
            <FontImageSource 
            FontFamily="MaterialIcons" 
            Glyph="&#xef3e;"
            Size="24"
            Color="{AppThemeBinding Light={StaticResource MidnightBlue},Dark={StaticResource White}}" />
        </FlyoutItem.Icon>
        <ShellContent ContentTemplate="{DataTemplate views:DashboardListPage}" Route="dashboard" />
    </FlyoutItem>
    <FlyoutItem Title="{Binding Path=[strLogradouros], Source={StaticResource LocalizedStrings}}">
        <FlyoutItem.Icon>
            <FontImageSource 
                FontFamily="MaterialIcons" 
                Glyph="&#xe0c8;"
                Size="24"
                Color="{AppThemeBinding Light={StaticResource MidnightBlue},Dark={StaticResource White}}" />
        </FlyoutItem.Icon>
        <ShellContent ContentTemplate="{DataTemplate views:LogradouroListPage}" Route="logradouros" />
    </FlyoutItem>
    <FlyoutItem Title="{Binding Path=[strColaboradores], Source={StaticResource LocalizedStrings}}">
        <FlyoutItem.Icon>
            <FontImageSource 
                FontFamily="MaterialIcons" 
                Glyph="&#xf233;"
                Size="24"
                Color="{AppThemeBinding Light={StaticResource MidnightBlue},Dark={StaticResource White}}" />
        </FlyoutItem.Icon>
        <ShellContent ContentTemplate="{DataTemplate views:ColaboradorListPage}" Route="colaboradores" />
    </FlyoutItem>
    <FlyoutItem Title="{Binding Path=[strAlunos], Source={StaticResource LocalizedStrings}}">
        <FlyoutItem.Icon>
            <FontImageSource 
                FontFamily="MaterialIcons" 
                Glyph="&#xe7ef;"
                Size="24"
                Color="{AppThemeBinding Light={StaticResource MidnightBlue},Dark={StaticResource White}}" />
        </FlyoutItem.Icon>
        <ShellContent ContentTemplate="{DataTemplate views:AlunoListPage}" Route="alunos" />
    </FlyoutItem>
    <FlyoutItem Title="{Binding Path=[strMatriculas], Source={StaticResource LocalizedStrings}}">
        <FlyoutItem.Icon>
            <FontImageSource 
                FontFamily="MaterialIcons" 
                Glyph="&#xe80c;"
                Size="24"
                Color="{AppThemeBinding Light={StaticResource MidnightBlue},Dark={StaticResource White}}" />
        </FlyoutItem.Icon>
        <ShellContent ContentTemplate="{DataTemplate views:MatriculaListPage}" Route="matriculas" />
    </FlyoutItem>
    <FlyoutItem Title="{Binding Path=[strConfiguracoes], Source={StaticResource LocalizedStrings}}">
        <FlyoutItem.Icon>
            <FontImageSource 
                FontFamily="MaterialIcons" 
                Glyph="&#xe8b8;"
                Size="24"
                Color="{AppThemeBinding Light={StaticResource MidnightBlue},Dark={StaticResource White}}" />
        </FlyoutItem.Icon>
        <ShellContent ContentTemplate="{DataTemplate views:ConfigPage}" Route="configuracoes"/>
    </FlyoutItem>
    <!--
     <TabBar>
     <ShellContent Title="Dashboard" ContentTemplate="{DataTemplate views:DashboardListPage}" Route="dashboard" /> <ShellContent Title="Logradouros" ContentTemplate="{DataTemplate views:LogradouroListPage}" Route="logradouros" /> </TabBar>
     -->
</Shell>